# Server-side only. Never prefix these with NEXT_PUBLIC_.

# Gemini API key — used only inside app/api/* routes.
GEMINI_API_KEY=

# Supabase — accounts + database (Phase 7).
# NEXT_PUBLIC_* values are safe to expose: they're the public anon key,
# protected by row-level security (see supabase/migrations/001_init.sql),
# not a secret by themselves.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
